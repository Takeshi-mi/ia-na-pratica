{
  "name": "ia-na-pratica-deck",
  "private": true,
  "description": "Gera o deck 'IA na Prática' em .pptx (pptxgenjs) ou em HTML com o mesmo layout (HTML=1).",
  "scripts": {
    "pptx": "node build.js",
    "html": "node -e \"process.env.HTML='1'; require('./build.js')\""
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5"
  }
}
